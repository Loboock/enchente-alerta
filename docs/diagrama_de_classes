<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Enchente Alerta – Diagrama de classes de domínio</title>
<style>
  body { margin: 0; padding: 24px; font-family: system-ui, sans-serif; background: #F1F3F9; color: #2B4A8B; }
  h1 { font-size: 20px; margin: 0 0 4px; }
  p { margin: 0 0 16px; font-size: 13px; color: #7A8194; }
  #diagrama { background: #fff; border: 1px solid #D9DDE7; border-radius: 10px; padding: 16px; overflow-x: auto; }
  #diagrama svg { max-width: 100%; height: auto; }
</style>
</head>
<body>
<h1>Enchente Alerta – Diagrama de classes de domínio</h1>
<p>Principais entidades do app, seus atributos, métodos e relacionamentos.</p>
<div id="diagrama">Carregando diagrama…</div>

<script type="module">
import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.esm.min.mjs';

mermaid.initialize({
  startOnLoad: false,
  theme: 'base',
  themeVariables: {
    fontSize: '13px',
    lineColor: '#2B4A8B',
    primaryColor: '#E8EDF8',
    primaryTextColor: '#1F2F7A',
    primaryBorderColor: '#2B4A8B'
  },
  class: { useMaxWidth: true }
});

const fonte = `classDiagram
direction TB
class Usuario {
  -String id
  -String email
  -String nome
  -DateTime criadoEm
  +cadastrar() bool
  +entrar(email, senha) bool
  +sair() void
  +recuperarSenha(email) void
  +atualizarDados(nome) void
}
class Endereco {
  -String id
  -String logradouro
  -String bairro
  -String cidade
  -double latitude
  -double longitude
  -bool padrao
  +definirComoPadrao() void
  +geocodificar() void
}
class PreferenciaNotificacao {
  -bool ativa
  -double raioKm
  +ativar() void
  +desativar() void
  +definirRaio(km) void
}
class Notificacao {
  -String id
  -String mensagem
  -DateTime enviadaEm
  -bool lida
  +enviar() void
  +marcarComoLida() void
}
class Alerta {
  -String id
  -String titulo
  -String descricao
  -NivelAlerta nivel
  -DateTime emitidoEm
  -DateTime expiraEm
  +estaAtivo() bool
  +encerrar() void
  +notificarUsuarios() void
}
class NivelAlerta {
  <<enumeration>>
  BAIXO
  MODERADO
  ALTO
  CRITICO
}
class AreaRisco {
  -String id
  -String nome
  -NivelAlerta nivelAtual
  -List poligono
  +contem(lat, lng) bool
  +atualizarNivel() void
}
class EstacaoMonitoramento {
  -String id
  -double latitude
  -double longitude
  -double nivelAguaCm
  -double chuvaMm
  -DateTime ultimaLeitura
  +lerDados() void
  +verificarLimite() bool
}
class Mapa {
  -double latitudeCentro
  -double longitudeCentro
  -int zoom
  +exibirAreasRisco() void
  +centralizarEm(lat, lng) void
  +buscarEndereco(texto) Endereco
}
class OcorrenciaHistorica {
  -String id
  -DateTime data
  -String bairro
  -NivelAlerta nivelMaximo
  +filtrarPorPeriodo(inicio, fim) List
}
class GuiaOrientacao {
  -String id
  -String titulo
  -String conteudo
  -String fase
  +exibir() void
  +filtrarPorNivel(nivel) List
}
Usuario "1" *-- "0..1" PreferenciaNotificacao : possui
Usuario "1" o-- "0..*" Endereco : cadastra
Usuario "1" --> "0..*" Notificacao : recebe
Endereco "0..*" --> "0..1" AreaRisco : localizado em
EstacaoMonitoramento "0..*" --> "1" AreaRisco : monitora
EstacaoMonitoramento "1" --> "0..*" Alerta : origina
Alerta "0..*" --> "1..*" AreaRisco : afeta
Alerta "1" --> "0..*" Notificacao : gera
Alerta "1" --> "0..1" OcorrenciaHistorica : arquivado como
Alerta "0..*" --> "0..*" GuiaOrientacao : recomenda
Alerta ..> NivelAlerta
Mapa "1" o-- "0..*" AreaRisco : exibe
Mapa "1" o-- "0..*" EstacaoMonitoramento : exibe`;

const { svg } = await mermaid.render('svg-classes', fonte);
document.getElementById('diagrama').innerHTML = svg;
</script>
</body>
</html>

